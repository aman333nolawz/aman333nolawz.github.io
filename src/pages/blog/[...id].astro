---
import MetaPost from "@/components/MetaPost.astro"
import PostActions from "@/components/PostActions.astro"
import ScrollToTop from "@/components/ScrollToTop.astro"
import SubpostNav from "@/components/custom/SubpostNav.astro"
import TableOfContents from "@/components/TableOfContents.astro"
import Layout from "@/layouts/Layout.astro"
import { getPosts, getSubposts } from "@/lib/content"
import { formatDate, isSubpost, subpostSlug } from "@/lib/utils"
import { Image } from "astro:assets"
import { getEntries, render, type CollectionEntry } from "astro:content"

export async function getStaticPaths() {
  const posts = await getPosts()
  const series = await getSubposts()
  const chains = posts.map((parent) => [
    parent,
    ...(series.get(parent.id) ?? []),
  ])
  const readingOrder = chains.flat()
  return chains.flatMap((chain) =>
    chain.map((post) => {
      const i = readingOrder.indexOf(post)
      return {
        params: { id: post.id },
        props: {
          post,
          chain,
          prev: readingOrder[i + 1],
          next: readingOrder[i - 1],
        },
      }
    }),
  )
}

type Props = {
  post: CollectionEntry<"blog">
  chain: CollectionEntry<"blog">[]
  prev?: CollectionEntry<"blog">
  next?: CollectionEntry<"blog">
}

const { post, chain, prev, next } = Astro.props
const [parent] = chain
const rendered = await Promise.all(
  chain.map(async (entry) => ({
    entry,
    ...(await render(entry)),
    authors: await getEntries(entry.data.authors),
  })),
)
const current = rendered.find(({ entry }) => entry.id === post.id)
if (!current) throw new Error(`Rendered post not found: ${post.id}`)

const chainIndex = chain.findIndex((entry) => entry.id === post.id)
const prevChain = chainIndex > 0 ? chain[chainIndex - 1] : undefined
const nextChain =
  chainIndex < chain.length - 1 ? chain[chainIndex + 1] : undefined

const sections = rendered.map(({ entry, headings }) => ({
  id: entry.id === post.id ? subpostSlug(entry.id) : undefined,
  href: entry.id === post.id ? undefined : `/blog/${entry.id}`,
  label: entry.data.title,
  open: entry.id === post.id,
  headings: headings.filter(
    ({ depth, text }) => depth >= 2 && depth <= 4 && text.trim(),
  ),
}))
const hasToc =
  sections.length > 1 || sections.some(({ headings }) => headings.length > 0)

const crumbs = [{ label: parent.data.title, href: `/blog/${parent.id}` }]
if (isSubpost(post.id)) {
  crumbs.push({ label: post.data.title, href: `/blog/${post.id}` })
}
---

<Layout crumbs={crumbs}>
  <MetaPost
    slot="head"
    post={post}
    canonical={isSubpost(post.id) ? `/blog/${parent.id}` : undefined}
  />
  {hasToc && (
    <TableOfContents slot="toc" title={parent.data.title} sections={sections} />
  )}
  <PostActions slot="actions" prev={prev} next={next} />
  <ScrollToTop floating />
  <article id={subpostSlug(post.id) || undefined}>
    <header>
      <h1>{current.entry.data.title}</h1>
      <post-meta>
        {current.authors.length > 0 && (
          <post-authors>
            <author-avatars>
              {current.authors.map((author) => (
                <img
                  src={author.data.avatar}
                  alt={author.data.name}
                  width="18"
                  height="18"
                />
              ))}
            </author-avatars>
            <author-names>
              {current.authors.map((author, j) => (
                <>
                  {j > 0 && ", "}
                  <a href={`/authors/${author.id}`}>{author.data.name}</a>
                </>
              ))}
            </author-names>
          </post-authors>
        )}
        <time datetime={current.entry.data.date.toISOString()}>
          {formatDate(current.entry.data.date)}
        </time>
        {current.entry.data.tags && (
          <post-tags>
            {current.entry.data.tags.map((tag) => (
              <a href={`/tags/${tag}`}>#{tag}</a>
            ))}
          </post-tags>
        )}
      </post-meta>
      <p>{current.entry.data.description}</p>
    </header>
    {current.entry.data.image && (
      <post-banner>
        <Image
          src={current.entry.data.image}
          alt={current.entry.data.title}
          width={1200}
          height={630}
          priority
        />
      </post-banner>
    )}
    <prose-content>
      <current.Content />
    </prose-content>
  </article>
  {(prevChain || nextChain) && (
    <SubpostNav
      prev={
        prevChain && {
          title: prevChain.data.title,
          href: `/blog/${prevChain.id}`,
        }
      }
      next={
        nextChain && {
          title: nextChain.data.title,
          href: `/blog/${nextChain.id}`,
        }
      }
    />
  )}
</Layout>

<style>
  header {
    margin-block-end: var(--space-m);

    h1 {
      font-size: var(--step-3);
      line-height: calc(var(--leading-offset) + 1em);
      font-weight: var(--font-weight-medium);
    }

    post-meta {
      --underline: var(--muted-foreground);

      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-3xs);
      margin-block-start: var(--space-3xs);
      font-size: var(--step--1);
      color: var(--muted-foreground);

      post-authors {
        display: flex;
        align-items: center;
        gap: var(--space-3xs);

        author-avatars {
          display: flex;
          margin-block-end: -0.1em;

          img {
            border-radius: var(--radius-full);
            box-shadow: 0 0 0 1.5px var(--background);

            &:not(:first-child) {
              margin-inline-start: -0.375rem;
            }
          }
        }
      }

      post-authors ~ time::before {
        content: "·";
        margin-inline-end: var(--space-3xs);
      }

      post-tags {
        --underline: transparent;

        display: flex;
        flex-wrap: wrap;
        gap: var(--space-3xs);

        a {
          color: color-mix(in oklab, var(--muted-foreground) 50%, transparent);

          &:hover {
            color: var(--foreground);
          }
        }
      }

      time ~ post-tags::before {
        content: "·";
      }

      a {
        color: var(--foreground);
      }
    }

    > p {
      margin-block-start: var(--space-2xs);
      font-size: var(--step--1);
      color: var(--muted-foreground);
    }
  }

  post-banner {
    display: block;
    margin-block-end: var(--space-m);

    :global(img) {
      inline-size: 100%;
      block-size: auto;
    }
  }
</style>
