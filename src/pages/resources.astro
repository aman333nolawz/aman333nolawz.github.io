const resourceTagCounts = Object.fromEntries(
  resourceTags.map((tag) => [
    tag,
    resources.filter((resource) => resource.tag === tag).length,
  ]),
) as Record<ResourceTag, number>
---

<Layout class="max-w-3xl">
  <PageHead slot="head" title="Resources" />
  <Breadcrumbs items={[{ label: 'Resources', icon: 'lucide:library' }]} />

  <section class="flex flex-col gap-y-5">
    <div>
      <h1 class="text-2xl font-medium">Resources</h1>
      <p class="text-muted-foreground mt-1 text-sm">
        Technical references, writeups, and essays worth keeping close.
      </p>
    </div>

    <div class="flex flex-wrap gap-2" id="resources-filter-bar">
      {
        (
          [
            { target: 'all', label: 'all', count: resources.length },
            ...resourceTags.map((tag) => ({
              target: tag,
              label: resourceTagMeta[tag].label,
              count: resourceTagCounts[tag],
            })),
          ] as const
        ).map(({ target, label, count }) => (
          <button
            class="resource-filter-btn inline-flex h-9 cursor-pointer items-center rounded-md px-3 text-sm font-medium transition-all"
            data-target={target}
            data-active={target === 'all' ? 'true' : 'false'}
          >
            {label}
            <span class="ml-1.5 font-normal opacity-60">{count}</span>
          </button>
        ))
      }
    </div>

    <ul class="flex flex-col gap-1.5" id="resources-list">
      {
        resources.map((resource) => (
          <li
            class="resource-item flex items-start gap-2 text-sm"
            data-tag={resource.tag}
          >
            <span
              class="resource-badge shrink-0 rounded px-1.5 py-0.5 text-[11px] font-medium"
              style={`--resource-badge-rgb: ${resourceTagMeta[resource.tag].rgb}; --resource-badge-foreground: ${resourceTagMeta[resource.tag].foreground};`}
            >
              {resourceTagMeta[resource.tag].label}
            </span>
            <span class="min-w-0 flex-1">
              <Link
                href={resource.url}
                external
                underline
                class="text-foreground hover:text-muted-foreground transition-colors"
              >
                {resource.title}
              </Link>
              {(resource.source || resource.note) && (
                <span class="text-muted-foreground ml-1">
                  {resource.source && <span>{resource.source}</span>}
                  {resource.source && resource.note && <span> · </span>}
                  {resource.note && <span>{resource.note}</span>}
                </span>
              )}
            </span>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>

<style>
  .resource-badge {
    --resource-badge-rgb: 122 162 247;
    --resource-badge-foreground: #7aa2f7;
    width: 4.2rem;
    border: 1px solid rgb(var(--resource-badge-rgb) / 0.28);
    background-color: rgb(var(--resource-badge-rgb) / 0.14);
    color: var(--resource-badge-foreground);
    backdrop-filter: blur(10px) saturate(140%);
    box-shadow: inset 0 1px 0 rgb(var(--resource-badge-rgb) / 0.12);
    text-align: center;
  }

  .resource-filter-btn {
    color: var(--muted-foreground);
  }

  .resource-filter-btn:hover {
    background-color: var(--muted);
    color: var(--foreground);
  }

  .resource-filter-btn[data-active='true'] {
    background-color: var(--primary);
    color: var(--primary-foreground);
  }

  .resource-filter-btn[data-active='true']:hover {
    background-color: color-mix(in oklch, var(--primary) 90%, transparent);
  }

  .resource-item.hidden {
    display: none;
  }
</style>

<script is:inline data-astro-rerun>
  ;(() => {
    const filterBar = document.getElementById('resources-filter-bar')
    const resourcesList = document.getElementById('resources-list')

    if (!filterBar || !resourcesList) return

    const filterBtns = Array.from(
      filterBar.querySelectorAll('.resource-filter-btn'),
    )
    const items = Array.from(resourcesList.querySelectorAll('.resource-item'))

    let currentFilter = 'all'

    function render() {
      items.forEach((item) => {
        const inFilter =
          currentFilter === 'all' || item.dataset.tag === currentFilter
        item.classList.toggle('hidden', !inFilter)
      })
    }

    filterBar.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target : null
      const button = target?.closest('.resource-filter-btn')
      if (!button?.dataset.target) return

      currentFilter = button.dataset.target
      filterBtns.forEach((filterButton) => {
        filterButton.dataset.active = String(
          filterButton.dataset.target === currentFilter,
        )
      })

      render()
    })

    render()
  })()
</script>
