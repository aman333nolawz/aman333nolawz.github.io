---
import ExternalIcon from "@/assets/icons/external.svg"
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import type { ResourceTag } from "@/lib/data-resources"
import { resources, resourceTagMeta } from "@/lib/data-resources"

const resourceTags = Object.keys(resourceTagMeta) as ResourceTag[]
const resourceTagCounts = Object.fromEntries(
  resourceTags.map((tag) => [
    tag,
    resources.filter((resource) => resource.tag === tag).length,
  ]),
) as Record<ResourceTag, number>
---

<Layout crumbs={[{ label: "Resources", href: "/resources" }]}>
  <MetaPage slot="head" title="Resources" />

  <section class="resources-page">
    <header class="resources-header">
      <h1>Resources</h1>
      <p class="resources-description">
        Technical references, writeups, and essays worth keeping close.
      </p>
    </header>

    <div class="filter-bar" id="resources-filter-bar">
      {(
        [
          { target: "all", label: "all", count: resources.length },
          ...resourceTags.map((tag) => ({
            target: tag,
            label: resourceTagMeta[tag].label,
            count: resourceTagCounts[tag],
          })),
        ] as const
      ).map(({ target, label, count }) => (
        <button
          class="resource-filter-btn"
          type="button"
          data-target={target}
          data-active={target === "all" ? "true" : "false"}
        >
          {label}
          <span class="resource-filter-count">{count}</span>
        </button>
      ))}
    </div>

    <ul class="resources-list" id="resources-list">
      {resources.map((resource) => (
        <li class="resource-item" data-tag={resource.tag}>
          <span
            class="resource-badge"
            style={`--resource-badge-rgb: ${resourceTagMeta[resource.tag].rgb}; --resource-badge-foreground: ${resourceTagMeta[resource.tag].foreground};`}
          >
            {resourceTagMeta[resource.tag].label}
          </span>
          <span class="resource-main">
            <a
              href={resource.url}
              target="_blank"
              rel="noopener noreferrer"
              class="resource-link"
            >
              {resource.title}
              <ExternalIcon aria-hidden="true" />
            </a>
            {(resource.source || resource.note) && (
              <span class="resource-meta">
                {resource.source && <span>{resource.source}</span>}
                {resource.source && resource.note && <span> · </span>}
                {resource.note && <span>{resource.note}</span>}
              </span>
            )}
          </span>
        </li>
      ))}
    </ul>
  </section>
</Layout>

<style>
  .resources-page {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }

  .resources-description {
    color: var(--muted-foreground);
    font-size: var(--step--1);
    margin-block-start: var(--space-3xs);
  }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  .resource-filter-btn {
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    height: 2.25rem;
    padding-inline: var(--space-xs);
    border-radius: var(--radius-sm);
    font-size: var(--step--1);
    font-weight: var(--font-weight-medium);
    color: var(--muted-foreground);
    transition: 300ms ease-in-out;
  }

  .resource-filter-btn:hover {
    background-color: var(--muted);
    color: var(--foreground);
  }

  .resource-filter-btn[data-active="true"] {
    background-color: var(--foreground);
    color: var(--background);
  }

  .resource-filter-count {
    font-weight: var(--font-weight-normal, 400);
    margin-inline-start: var(--space-3xs);
    opacity: 60%;
  }

  .resources-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
  }

  .resource-item {
    align-items: flex-start;
    display: flex;
    font-size: var(--step--1);
    gap: var(--space-2xs);
  }

  .resource-badge {
    flex-shrink: 0;
    width: 4.2rem;
    border: 1px solid rgb(var(--resource-badge-rgb) / 0.28);
    border-radius: var(--radius-xs);
    background-color: rgb(var(--resource-badge-rgb) / 0.14);
    color: var(--resource-badge-foreground);
    backdrop-filter: blur(10px) saturate(140%);
    box-shadow: inset 0 1px 0 rgb(var(--resource-badge-rgb) / 0.12);
    font-size: 0.6875rem;
    font-weight: var(--font-weight-medium);
    text-align: center;
    padding: var(--space-3xs) var(--space-2xs);
  }

  .resource-main {
    min-width: 0;
    flex: 1 1 0;
  }

  .resource-link {
    color: var(--foreground);
    text-decoration: underline;
    text-decoration-color: var(--muted-foreground);
    text-underline-offset: 3px;
    transition: 300ms ease-in-out;
  }

  .resource-link:hover {
    color: var(--muted-foreground);
  }

  .resource-link :global(svg) {
    display: inline-block;
    inline-size: 0.75em;
    margin-inline-start: var(--space-3xs);
  }

  .resource-meta {
    color: var(--muted-foreground);
    margin-inline-start: var(--space-3xs);
  }

  .resource-item.hidden {
    display: none;
  }
</style>

<script is:inline data-astro-rerun>
  ;(() => {
    const filterBar = document.getElementById("resources-filter-bar")
    const resourcesList = document.getElementById("resources-list")

    if (!filterBar || !resourcesList) return

    const filterBtns = Array.from(
      filterBar.querySelectorAll(".resource-filter-btn"),
    )
    const items = Array.from(resourcesList.querySelectorAll(".resource-item"))

    let currentFilter = "all"

    function render() {
      items.forEach((item) => {
        const inFilter =
          currentFilter === "all" || item.dataset.tag === currentFilter
        item.classList.toggle("hidden", !inFilter)
      })
    }

    filterBar.addEventListener("click", (event) => {
      const target = event.target instanceof Element ? event.target : null
      const button = target?.closest(".resource-filter-btn")
      if (!button?.dataset.target) return

      currentFilter = button.dataset.target
      filterBtns.forEach((filterButton) => {
        filterButton.dataset.active = String(
          filterButton.dataset.target === currentFilter,
        )
      })

      render()
    })

    render()
  })()
</script>
