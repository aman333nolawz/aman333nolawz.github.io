---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import PageHead from '@/components/PageHead.astro'
import Layout from '@/layouts/Layout.astro'

import GoodreadsGrid from '@/components/custom/GoodreadsGrid.astro'
import GoodreadsUserUpdates from '@/components/custom/GoodreadsUserUpdates.astro'
---

<Layout class="max-w-5xl">
  <PageHead slot="head" title="Reading" />
  <Breadcrumbs items={[{ label: 'Reading', icon: 'lucide:book' }]} />

  <section>
    <div class="lg:flex lg:gap-4">
      <div class="lg:w-1/3">
        <h2 class="mb-3 text-xl font-semibold text-gray-600">
          <a
            href="https://www.goodreads.com/user/show/201671700-aman-p"
            target="_blank"
            class="relative inline-flex transform items-center rounded-full border border-[#723c0c]/25 bg-[#f9f6f2] px-3 py-0.5 text-sm font-medium text-[#723c0c] transition-transform hover:opacity-70 dark:border-[#f9f6f2]/25 dark:bg-[#723c0c] dark:text-[#f9f6f2]"
          >
            <span
              class="absolute left-2 h-2 w-2 animate-ping rounded-full bg-[#723c0c] duration-1400 dark:bg-[#f9f6f2]"
            ></span>
            <span
              class="absolute left-2 h-2 w-2 rounded-full bg-[#723c0c] dark:bg-[#f9f6f2]"
            ></span>
            <span class="ml-[10px]">Goodreads Activity</span>
          </a>
        </h2>
        <GoodreadsUserUpdates limit={10} />
      </div>
      <div class="mt-8 lg:mt-0 lg:w-3/4">
        <h2 class="mb-4 text-xl">
          <a
            href="https://www.goodreads.com/review/list/201671700-aman-p?shelf=read&sort=date_read&order=d"
            target="_blank"
            class="text-md relative inline-flex transform items-center"
          >
            Goodreads: Latest Reads
          </a>
        </h2>
        <GoodreadsGrid />
      </div>
    </div>
  </section>
</Layout>
