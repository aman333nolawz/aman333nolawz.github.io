---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import PageHead from '@/components/PageHead.astro'
import Layout from '@/layouts/Layout.astro'

import GoodreadsGrid from '@/components/custom/GoodreadsGrid.astro'
import GoodreadsUserUpdates from '@/components/custom/GoodreadsUserUpdates.astro'
---

<Layout class="max-w-5xl">
  <PageHead slot="head" title="Reading" />
  <Breadcrumbs items={[{ label: 'Reading', icon: 'lucide:book' }]} />

  <section>
    <div class="grid gap-8 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,2.1fr)]">
      <div>
        <h2 class="mb-3">
          <a
            href="https://www.goodreads.com/user/show/201671700-aman-p"
            target="_blank"
            class="hover:bg-secondary/70 bg-background relative inline-flex items-center rounded-md border px-3 py-1 text-sm font-medium transition-colors"
          >
            <span
              class="bg-primary absolute left-2 h-2 w-2 animate-ping rounded-full duration-1400"
            ></span>
            <span class="bg-primary absolute left-2 h-2 w-2 rounded-full"
            ></span>
            <span class="ml-[10px]">Goodreads Activity</span>
          </a>
        </h2>
        <GoodreadsUserUpdates limit={10} />
      </div>
      <div>
        <h2 class="mb-4 text-2xl font-medium">
          <a
            href="https://www.goodreads.com/review/list/201671700-aman-p?shelf=read&sort=date_read&order=d"
            target="_blank"
            class="hover:text-muted-foreground transition-colors"
          >
            Latest reads
          </a>
        </h2>
        <GoodreadsGrid />
      </div>
    </div>
  </section>
</Layout>
