---
import Logo from "@/assets/logo.svg"
import ListIcon from "@/assets/icons/list.svg"
import XIcon from "@/assets/icons/x.svg"
import ThemeToggle from "@/components/ThemeToggle.astro"
import { NAVIGATION, SITE } from "@/consts"
import { normalizePath } from "@/lib/utils"

type Props = { crumbs?: { label: string; href: string }[] }

const { crumbs = [] } = Astro.props
const pathname = normalizePath(Astro.url.pathname) || "/"
const section = NAVIGATION.find(
  ({ href }) => pathname === href || pathname.startsWith(`${href}/`),
)
---

<aside data-bar>
  <sidebar-inner>
    <a href="/" aria-label={SITE.title}>
      <Logo />
      <span>{SITE.title}</span>
    </a>
    <nav id="site-nav" data-site-nav>
      <ul>
        {NAVIGATION.map((item, i) => (
          <li style={`--i: ${i}`}>
            <a
              href={item.href}
              aria-current={pathname === item.href ? "page" : undefined}
            >
              {item.label}
            </a>
            {item === section &&
              crumbs.length > 0 &&
              pathname !== item.href && (
                <ul>
                  {crumbs.map((crumb, i) => (
                    <li style={`--i: ${i}`} data-depth={i ? 1 : undefined}>
                      <a
                        href={crumb.href}
                        aria-current={
                          i === crumbs.length - 1 ? "page" : undefined
                        }
                      >
                        {crumb.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
          </li>
        ))}
        {!section &&
          crumbs.map((crumb, i) => (
            <li style={`--i: ${i}`} data-depth={i ? 1 : undefined}>
              <a
                href={crumb.href}
                aria-current={i === crumbs.length - 1 ? "page" : undefined}
              >
                {crumb.label}
              </a>
            </li>
          ))}
      </ul>
    </nav>
  </sidebar-inner>
  <sidebar-toggle>
    <slot name="toggle" />
    <button
      data-nav-toggle
      data-icon-button
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Toggle navigation"
    >
      <menu-icon><ListIcon /></menu-icon>
      <close-icon><XIcon /></close-icon>
    </button>
    <ThemeToggle />
    <slot name="actions" />
  </sidebar-toggle>
</aside>

<style>
  aside {
    position: sticky;
    top: var(--page-offset-top);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: calc(100svh - var(--page-offset-top) - var(--page-offset-bottom));

    @media (width < 64rem) {
      position: static;
      height: auto;
    }

    @media (width < 40rem) {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: flex-start;
      gap: var(--space-s);
      row-gap: var(--space-2xs);
    }

    @media (40rem <= width < 64rem) {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-2xs);
    }
  }

  sidebar-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);

    > a {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      width: fit-content;
      font-weight: var(--font-weight-medium);
      font-size: var(--step-0);
      color: var(--foreground);
      text-decoration-line: none;

      svg {
        inline-size: 1.125rem;
        block-size: 1.125rem;
        flex-shrink: 0;
      }

      @media (width < 20rem) {
        span {
          display: none;
        }
      }
    }

    @media (width < 40rem) {
      flex: 1 1 0;
      min-width: 0;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      row-gap: var(--space-2xs);
    }

    @media (40rem <= width < 64rem) {
      flex: 1 1 0;
      min-width: 0;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-s);
      row-gap: var(--space-2xs);
    }
  }

  nav {
    @media (40rem <= width < 64rem) {
      margin-inline-start: auto;
    }
  }

  nav ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);

    a {
      display: block;
      color: var(--muted-foreground);
      transition: color 150ms ease;

      &:hover,
      &[aria-current="page"] {
        color: var(--foreground);
      }
    }

    li[data-depth="1"] a {
      margin-inline-start: var(--space-xs);
    }

    ul {
      margin-block-start: var(--space-3xs);

      a {
        margin-inline-start: var(--space-xs);
      }

      li[data-depth="1"] a {
        margin-inline-start: calc(2 * var(--space-xs));
      }
    }

    @media (width < 40rem) {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-s);
      row-gap: var(--space-2xs);

      ul {
        display: none;
      }

      a {
        white-space: nowrap;
        padding-block: 0.25rem;
      }
    }

    @media (40rem <= width < 64rem) {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-s);
      row-gap: var(--space-2xs);

      ul {
        display: none;
      }

      a {
        white-space: nowrap;
        padding-block: 0.25rem;
      }
    }
  }

  nav li:has(> ul) > a {
    @media (width < 40rem) {
      color: var(--foreground);
    }
  }

  [data-nav-toggle],
  menu-icon,
  close-icon {
    display: none;
  }

  menu-icon,
  close-icon {
    svg {
      width: 1rem;
      height: 1rem;
    }
  }

  @media (width < 40rem) {
    [data-nav-toggle] {
      display: inline-flex;
      position: relative;
    }

    menu-icon,
    close-icon {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      opacity: 0;
      transform: scale(0.75);
      transition:
        opacity 150ms ease,
        transform 150ms ease;
    }

    [data-nav-toggle] menu-icon {
      opacity: 1;
      transform: scale(1);
    }

    [data-nav-toggle][aria-expanded="true"] menu-icon {
      opacity: 0;
      transform: scale(0.75);
    }

    [data-nav-toggle][aria-expanded="true"] close-icon {
      opacity: 1;
      transform: scale(1);
    }

    nav {
      display: none;
    }

    aside[data-menu-open] nav,
    aside[data-menu-closing] nav {
      display: flex;
      flex: 1 1 100%;
    }

    aside[data-menu-closing] nav {
      pointer-events: none;
    }

    aside[data-menu-open] nav {
      animation: site-nav-open 200ms cubic-bezier(0.33, 1, 0.68, 1);
    }

    aside[data-menu-closing] nav {
      animation: site-nav-close 150ms ease forwards;
    }

    aside[data-menu-open] nav ul,
    aside[data-menu-closing] nav ul {
      flex-direction: column;
      align-items: flex-start;
      width: 100%;
    }

    aside[data-menu-open] nav li {
      animation: site-nav-item-open 250ms cubic-bezier(0.33, 1, 0.68, 1)
        backwards;
      animation-delay: calc(var(--i, 0) * 25ms);
    }
  }

  sidebar-toggle {
    display: flex;
    align-items: center;
    margin-inline-start: -0.5rem;

    @media (width < 40rem) {
      margin-inline-start: 0;
      margin-inline-end: -0.5rem;
    }
  }
</style>

<style is:global>
  @keyframes site-nav-open {
    from {
      opacity: 0;
      transform: translateY(-0.5rem);
    }
  }

  @keyframes site-nav-item-open {
    from {
      opacity: 0;
      transform: translateY(0.25rem);
    }
  }

  @keyframes site-nav-close {
    to {
      opacity: 0;
      transform: translateY(-0.5rem);
    }
  }
</style>

<script>
  const bar = document.querySelector("aside[data-bar]")
  const toggle = bar?.querySelector("[data-nav-toggle]")
  const nav = bar?.querySelector("[data-site-nav]")
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)")

  const openMenu = () => {
    bar?.removeAttribute("data-menu-closing")
    bar?.setAttribute("data-menu-open", "")
    toggle?.setAttribute("aria-expanded", "true")
  }

  const closeMenu = () => {
    bar?.removeAttribute("data-menu-open")
    toggle?.setAttribute("aria-expanded", "false")
    if (!reduceMotion.matches) {
      bar?.setAttribute("data-menu-closing", "")
    }
  }

  toggle?.addEventListener("click", () => {
    if (bar?.hasAttribute("data-menu-open")) {
      closeMenu()
    } else {
      openMenu()
    }
  })

  nav?.addEventListener("click", ({ target }) => {
    if (target instanceof Element && target.closest("a")) {
      closeMenu()
    }
  })

  nav?.addEventListener("animationend", ({ animationName }) => {
    if (animationName === "site-nav-close") {
      bar?.removeAttribute("data-menu-closing")
    }
  })

  matchMedia("(width >= 40rem)").addEventListener("change", ({ matches }) => {
    if (!matches) return
    bar?.removeAttribute("data-menu-open")
    bar?.removeAttribute("data-menu-closing")
    toggle?.setAttribute("aria-expanded", "false")
  })
</script>
