---
import { getCollection } from "astro:content"
import { Image } from "astro:assets"
import GoodreadsIcon from "./GoodreadsIcon.astro"

type Props = {
  gridMarginTop?: number
  titleMarginTop?: number
  ratingMarginBottom?: number
  filterYear?: number
  filterTitles?: string[]
}

const {
  gridMarginTop = 4,
  titleMarginTop = 1,
  ratingMarginBottom = 4,
  filterYear,
  filterTitles,
} = Astro.props

interface Book {
  data: {
    title: string
    author?: string
    author_name?: string
    book_id: number | string
    user_rating?: number
    user_read_at?: string
    image?: string
    book_image_url?: string
    book_small_image_url?: string
    book_medium_image_url?: string
    book_large_image_url?: string
    order?: number
  }
}

let books = (await getCollection("goodreads_read_books")) as unknown as Book[]

if (filterTitles && filterTitles.length > 0) {
  books = filterTitles.flatMap((filterTitle) =>
    books
      .filter((book) => book.data.title === filterTitle)
      .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0)),
  )
} else {
  // Sort in reverse chronological order with never-read books on top
  books.sort((a, b) => {
    if (!a.data.user_read_at) return -1
    if (!b.data.user_read_at) return 1
    return (
      new Date(b.data.user_read_at).getUTCMilliseconds() -
      new Date(a.data.user_read_at).getUTCMilliseconds()
    )
  })
}

if (filterYear) {
  books = books.filter(
    (book) => new Date(book.data.user_read_at).getUTCFullYear() === filterYear,
  )
}

const formatDate = (dateString: string) => {
  if (!dateString) {
    return "———"
  }
  const date = new Date(dateString)
  return date.toLocaleDateString("en-US", {
    day: "numeric",
    month: "long",
    year: "numeric",
  })
}
---

<div
  class="goodreads wide-img"
  style={`margin-top: ${gridMarginTop * 0.25}rem`}
>
  <ul
    class="goodreads-grid"
    style="grid-template-columns: repeat(auto-fit, minmax(5.75rem, 1fr))"
  >
    {books.map((book) => {
      const cover =
        book.data.image ||
        book.data.book_large_image_url ||
        book.data.book_image_url ||
        book.data.book_medium_image_url ||
        book.data.book_small_image_url
      const author = book.data.author || book.data.author_name
      return (
        <li class="goodreads-book">
          <a
            href={`https://www.goodreads.com/book/show/${book.data.book_id}`}
            class="goodreads-cover-link"
            target="_blank"
            rel="noopener noreferrer"
          >
            <div class="goodreads-cover-inner">
              {cover ? (
                <Image
                  src={cover}
                  alt={`${book.data.title} by ${author}`}
                  width={101}
                  height={150}
                  loading="lazy"
                  class="zoomable-image"
                  onload="this.classList.add('loaded')"
                />
              ) : (
                <div class="goodreads-placeholder">
                  <div class="goodreads-grid-icon-box">
                    <GoodreadsIcon
                      name="image"
                      class="goodreads-grid-placeholder-icon"
                    />
                  </div>
                </div>
              )}
            </div>
          </a>
          <div
            class="goodreads-book-meta"
            style={`margin-top: ${titleMarginTop * 0.25}rem`}
          >
            <a
              href={`https://www.goodreads.com/book/show/${book.data.book_id}`}
              class="goodreads-book-title"
              target="_blank"
              rel="noopener noreferrer"
            >
              {book.data.title}
            </a>
            {author && <span class="goodreads-book-author">{author}</span>}
            {book.data.user_read_at !== "" && (
              <span class="goodreads-book-date">
                {formatDate(book.data.user_read_at || "")}
              </span>
            )}
          </div>
          <div
            class="goodreads-rating"
            title={book.data.user_rating}
            style={`margin-bottom: ${ratingMarginBottom * 0.25}rem`}
          >
            {Array.from({ length: 5 }).map((_, i) => (
              <svg
                class={`goodreads-star${book.data.user_rating && book.data.user_rating > i ? " goodreads-star-filled" : ""}`}
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
              </svg>
            ))}
          </div>
        </li>
      )
    })}
  </ul>
</div>

<style>
  .goodreads-grid {
    display: grid;
    gap: 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .goodreads-book {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .goodreads-cover-link {
    display: block;
    width: 6rem;
    height: 9rem;
    color: inherit;
    text-decoration: none;
  }

  .goodreads-cover-inner {
    position: relative;
    z-index: 10;
    width: 100%;
    height: 100%;
    transform: translateY(0) scale(1);
    transform-origin: center bottom;
    transition: all 0.3s;
  }

  .goodreads-cover-link:hover .goodreads-cover-inner {
    z-index: 20;
    transform: translateY(-0.25rem) scale(1.3);
  }

  .goodreads-placeholder {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    opacity: 1;
    background-color: var(--muted);
    border-radius: var(--radius-lg);
    transition:
      opacity 0.5s,
      background-color 0.3s;
  }

  .goodreads-grid-icon-box {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-xl);
  }

  .goodreads-grid-placeholder-icon {
    width: 2.5rem;
    height: 2.5rem;
    color: var(--muted-foreground);
  }

  .goodreads-book-meta {
    text-align: center;
  }

  .goodreads-book-title {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    width: 7.5rem;
    margin-inline: auto;
    font-size: 0.875rem;
    line-height: 1.25;
    font-weight: 700;
    color: var(--foreground);
    text-decoration: none;
  }

  .goodreads-book-title:hover {
    text-decoration: underline;
  }

  .goodreads-book-author {
    display: block;
    overflow: hidden;
    width: 6rem;
    margin-inline: auto;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.875rem;
    line-height: 1.25;
    color: var(--muted-foreground);
  }

  .goodreads-book-date {
    display: block;
    font-size: 0.875rem;
    line-height: 1.25;
    font-weight: 300;
    color: var(--muted-foreground);
  }

  .goodreads-rating {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .goodreads-star {
    width: 1rem;
    height: 1rem;
    color: var(--muted);
  }

  .goodreads-star-filled {
    color: var(--foreground);
  }
</style>

<style is:global>
  .zoomable-image {
    opacity: 0;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-md);
    transition: opacity 0.5s;
  }

  .zoomable-image.loaded {
    opacity: 1;
  }

  .hidden {
    display: none !important;
  }
</style>
