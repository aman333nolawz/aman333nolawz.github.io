---
import type { SvgComponent } from "astro/types"

type Props = { links: { href: string; label: string; icon: SvgComponent }[] }

const { links } = Astro.props
---

<ul>
  {links.map(({ href, label, icon: Icon }) => (
    <li>
      <a
        href={href}
        data-icon-button
        data-social-platform={label}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={label}
        title={label}
      >
        <Icon aria-hidden="true" />
      </a>
    </li>
  ))}
</ul>

<style>
  ul {
    display: flex;
    margin-inline: -0.5rem;

    li a {
      color: var(--muted-foreground);
      text-decoration: none;

      &:hover {
        color: var(--foreground);
      }

      svg {
        width: 1.125rem;
        height: 1.125rem;
      }
    }
  }
</style>

<script>
  const handleSocialLinkClick = function (this: HTMLAnchorElement) {
    window.posthog?.capture("social_link_clicked", {
      platform: this.dataset.socialPlatform,
    })
  }

  function setupSocialIconsTracking() {
    document
      .querySelectorAll<HTMLAnchorElement>("a[data-social-platform]")
      .forEach((link) => {
        link.removeEventListener("click", handleSocialLinkClick)
        link.addEventListener("click", handleSocialLinkClick)
      })
  }

  setupSocialIconsTracking()
  document.addEventListener("astro:page-load", setupSocialIconsTracking)
</script>
