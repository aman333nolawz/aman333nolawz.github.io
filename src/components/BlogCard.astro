---
import { formatDate, sizedAvatar } from "@/lib/utils"
import { Image } from "astro:assets"
import { getEntries, type CollectionEntry } from "astro:content"

type Props = { post: CollectionEntry<"blog">; revealDelay?: number }

const { post, revealDelay } = Astro.props
const authors = await getEntries(post.data.authors)
---

<li
  data-reveal={revealDelay === undefined ? undefined : ""}
  style={revealDelay === undefined
    ? undefined
    : `--reveal-delay: ${revealDelay}ms`}
>
  {post.data.image && (
    <a
      href={`/blog/${post.id}`}
      tabindex="-1"
      aria-hidden="true"
      data-post-id={post.id}
      data-post-title={post.data.title}
    >
      <Image src={post.data.image} alt="" width={640} height={336} />
    </a>
  )}
  <entry-info>
    <a
      href={`/blog/${post.id}`}
      data-post-id={post.id}
      data-post-title={post.data.title}
      >{post.data.title}</a
    >
    <entry-meta>
      {authors.length > 0 && (
        <entry-authors>
          <author-avatars>
            {authors.map((author) => (
              <img
                src={sizedAvatar(author.data.avatar, 64)}
                alt={author.data.name}
                width="18"
                height="18"
                loading="lazy"
                decoding="async"
              />
            ))}
          </author-avatars>
          <author-names>
            {authors.map((author, i) => (
              <>
                {i > 0 && ", "}
                {author.data.name}
              </>
            ))}
          </author-names>
        </entry-authors>
      )}
      <time datetime={post.data.date.toISOString()}
        >{formatDate(post.data.date)}</time
      >
      {post.data.tags && (
        <entry-tags>
          {post.data.tags.map((tag) => (
            <span>#{tag}</span>
          ))}
        </entry-tags>
      )}
    </entry-meta>
    <p>{post.data.description}</p>
  </entry-info>
</li>

<script>
  const handleBlogCardClick = function (this: HTMLAnchorElement) {
    window.posthog?.capture("blog_post_clicked", {
      post_id: this.dataset.postId,
      post_title: this.dataset.postTitle,
    })
  }

  function setupBlogCardTracking() {
    document
      .querySelectorAll<HTMLAnchorElement>("a[data-post-id]")
      .forEach((link) => {
        link.removeEventListener("click", handleBlogCardClick)
        link.addEventListener("click", handleBlogCardClick)
      })
  }

  setupBlogCardTracking()
  document.addEventListener("astro:page-load", setupBlogCardTracking)
</script>

<style>
  li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-s);

    > a {
      flex-shrink: 0;
      inline-size: 14rem;
      overflow: hidden;
      border-radius: var(--radius-md);

      :global(img) {
        inline-size: 100%;
        block-size: auto;
        transition: transform 400ms cubic-bezier(0.16, 1, 0.3, 1);
      }
    }

    &:hover > a :global(img) {
      transform: scale(1.05);
    }

    entry-info {
      display: flex;
      flex-direction: column;

      > a {
        font-size: var(--step-1);
        line-height: calc(var(--leading-offset) + 1em);
        font-weight: var(--font-weight-medium);
      }

      entry-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-3xs);
        margin-block-end: var(--space-3xs);
        font-size: var(--step--1);
        color: var(--muted-foreground);

        entry-authors {
          display: flex;
          align-items: center;
          gap: var(--space-3xs);

          author-avatars {
            display: flex;
            margin-block-end: -0.1em;

            img {
              border-radius: var(--radius-full);
              box-shadow: 0 0 0 1.5px var(--background);

              &:not(:first-child) {
                margin-inline-start: -0.375rem;
              }
            }
          }
        }

        entry-authors ~ time::before {
          content: "·";
          margin-inline-end: var(--space-3xs);
        }

        entry-tags {
          display: flex;
          flex-wrap: wrap;
          gap: var(--space-3xs);

          span {
            color: color-mix(
              in oklab,
              var(--muted-foreground) 50%,
              transparent
            );
          }
        }

        time ~ entry-tags::before {
          content: "·";
        }
      }

      p {
        color: var(--muted-foreground);
      }
    }

    @media (width < 40rem) {
      flex-direction: column;

      > a {
        inline-size: 100%;
        max-inline-size: 32rem;
      }
    }
  }
</style>
