---
import { Separator } from '@/components/ui/separator'
import { SOCIAL_LINKS } from '@/consts'
import { Icon } from 'astro-icon/components'
import Link from './Link.astro'
import SocialIcons from './SocialIcons.astro'
---

<footer class="py-4">
  <div
    class="mx-auto flex max-w-3xl flex-col items-start gap-y-4 px-4 sm:flex-row sm:items-center sm:justify-between"
  >
    <div class="flex flex-col items-start gap-y-2 text-left">
      <div class="text-muted-foreground flex items-center gap-x-3 text-sm">
        <Link
          href="https://ring.seggs.lol"
          class="text-foreground font-medium font-mono"
        >
          thread<span class="text-[#907aa9] dark:text-[#c4a7e7]"
            >locked
          </span>webring:
        </Link>
        <Link
          href="https://ring.seggs.lol/redirect?from=nolawz&dir=prev"
          title="Previous site"
        >
          <Icon name="lucide:arrow-left" class="size-4" />
        </Link>
        <Link href="https://ring.seggs.lol/random" title="Random site">
          <Icon name="lucide:dices" class="size-4" />
        </Link>
        <Link
          href="https://ring.seggs.lol/redirect?from=nolawz&dir=next"
          title="Next site"
        >
          <Icon name="lucide:arrow-right" class="size-4" />
        </Link>
      </div>
      <div class="flex flex-wrap items-center gap-x-2">
        <span class="text-muted-foreground text-sm">
          &copy; {new Date().getFullYear()} All rights reserved.
        </span>
        <Separator orientation="vertical" className="hidden h-4! sm:block" />
        <p class="text-muted-foreground text-sm">
          Made with 🤍 by <Link
            href="https://github.com/aman333nolawz"
            class="text-foreground"
            external
            underline>Nolawz</Link
          >!
        </p>
      </div>
    </div>
    <SocialIcons links={SOCIAL_LINKS} />
  </div>
</footer>
